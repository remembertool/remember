{
  "version": 1,
  "description": "uEMSC results published in the paper, used to compare a live REMEMBER benchmark run with the 8 competitor techniques and with the VLMC result reported in the paper.",
  "source": {
    "citation": "E. Incerto, A. Vandin, S. Sarv Ahrabi. Stochastic conformance checking based on variable-length Markov chains. Information Systems 133 (2025) 102561.",
    "doi": "10.1016/j.is.2025.102561",
    "figures": "Figs. 4 and 5",
    "extraction": "Values were read from the vector drawing data of Figs. 4 and 5 (box edges, whisker caps, outlier markers and the orange mean line), calibrated on the y-axis grid lines of each plot. Accuracy is about +/-0.001 uEMSC.",
    "statistic": "In the paper the line inside each box is the mean of the 10 splits; the box spans the 25th to 75th percentile; whiskers and circles follow the usual box-plot convention. For the techniques from Leemans et al. 2024 [21] the paper reports only the mean value."
  },
  "qualitative": {
    "DFM": "Directly Follows Model miner",
    "IMf": "Inductive Miner infrequent",
    "FM": "Flower model"
  },
  "stochastic": {
